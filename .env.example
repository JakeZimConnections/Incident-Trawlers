# Copy to .env and fill in. Read by app/core/config.py.
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-5-5
RECURSION_LIMIT=20
TRACELOG_DIR=tracelogs
LOG_LEVEL=info

# LangSmith tracing (EU region). Each workflow gets its own project: <LANGSMITH_PROJECT>-<workflow>
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=incident-trawlers
